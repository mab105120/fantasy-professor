{
  "$defs": {
    "MemoryItem": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "action",
            "watch",
            "position"
          ],
          "title": "Kind",
          "type": "string"
        },
        "week": {
          "maximum": 18,
          "minimum": 1,
          "title": "Week",
          "type": "integer"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "players": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlayerRef"
          },
          "title": "Players",
          "type": "array"
        },
        "team_ids": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Team Ids",
          "type": "array"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        },
        "revisit_week": {
          "anyOf": [
            {
              "maximum": 18,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revisit Week"
        },
        "id": {
          "pattern": "^m\\d{3,}$",
          "title": "Id",
          "type": "string"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "closed",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "created": {
          "format": "date",
          "title": "Created",
          "type": "string"
        },
        "updated": {
          "format": "date",
          "title": "Updated",
          "type": "string"
        },
        "closed": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closed"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        }
      },
      "required": [
        "kind",
        "week",
        "summary",
        "id",
        "created",
        "updated"
      ],
      "title": "MemoryItem",
      "type": "object"
    },
    "PlayerRef": {
      "additionalProperties": false,
      "description": "A player mention. `player_id` (ESPN id, same in fantasy and site APIs)\nis the join key; `name` is display-only.",
      "properties": {
        "player_id": {
          "title": "Player Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "pro_team": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pro Team"
        },
        "position": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        }
      },
      "required": [
        "player_id",
        "name"
      ],
      "title": "PlayerRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "season": {
      "title": "Season",
      "type": "integer"
    },
    "items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MemoryItem"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "season"
  ],
  "title": "SeasonMemory",
  "type": "object"
}
